rules_version = '2';

// Uploads live under <folder>/<uid>/… (see src/lib/files.ts). Members may only
// write inside their own uid folder, files are capped at 15 MB, and reads stay
// inside signed-in members — shared files travel via unguessable download URLs.
service firebase.storage {
  match /b/{bucket}/o {
    match /{folder}/{uid}/{name} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && folder in ['chat', 'dataroom', 'assets', 'community', 'decks']
        && request.resource.size < 15 * 1024 * 1024;
    }
  }
}
